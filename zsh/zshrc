# Show ipv4&6 addresses
netinfo() {
    printf 'IPv4: '
    ip -o -4 addr show scope global up | awk '{print $4}' | cut -d/ -f1 | xargs echo -n
    printf '\nIPv6: '
    ip -o -6 addr show scope global up | awk '{print $4}' | cut -d/ -f1 | xargs echo -n
    printf '\n'
}

# Internal + External IPs
alias whatsmyip="whatismyip"
whatismyip() {
    printf 'Internal:\n'; netinfo
    printf 'External:\nIPv4: '
    if _have curl; then curl -fsS --max-time 4 https://v4.ident.me/ || true
    else wget -qO- https://v4.ident.me/ || true; fi
    printf '\nIPv6: '
    if _have curl; then curl -fsS --max-time 4 https://v6.ident.me/ || true
    else wget -qO- https://v6.ident.me/ || true; fi
    printf '\n'
}

# Nginx log tail
nginxlog() {
    cd /var/log/nginx/ || return
    ls -xAh
    if _have multitail; then multitail --no-repeat -c -s 2 /var/log/nginx/*.log
    else tail -F /var/log/nginx/*.log
    fi
}

# Trim whitespace
trim() {
    local s
    if [ $# -gt 0 ]; then s=$*; else s=$(cat); fi
    s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Open anything
o() { [ $# -eq 0 ] && _open_url "." || _open_url "$*"; }
alias open='o'

# tree with pager
tre() { _have tree && tree -aC -I '.git' --dirsfirst "$@" | less -FRNX; }

# Open repo in a browser
repo() {
    _have git || { echo "git not found"; return 1; }
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Not a git repo!"; return 1; }
    local url base branch rel tree="tree"
    base=$(git remote get-url origin 2>/dev/null) || { echo "No origin remote"; return 1; }
    base=${base%.git}
    base=${base/git@github.com:/https://github.com/}
    base=${base/git@gitlab.com:/https://gitlab.com/}
    base=${base/git@bitbucket.org:/https://bitbucket.org/}
    base=${base/git:\/\/github.com/https:\/\/github.com}
    [[ $base == *bitbucket* ]] && tree="src"
    branch=$(git name-rev --name-only --no-undefined --always HEAD 2>/dev/null)
    rel="$(pwd)"; rel="${rel#$(cd "./$(git rev-parse --show-cdup)" || return; pwd)}"
    url="${base}/${tree}/${branch}${rel}"
    echo "Opening $url"
    _open_url "$url"
}

# Notify wether a website is up
isup() {
    local uri=$1; [ -n "$uri" ] || { echo "Usage: isup <url>"; return 2; }
    local ok=1
    if _have curl; then curl -fsS --max-time 5 -o /dev/null -w "%{http_code}" "$uri" | grep -q '^2' && ok=0
    else wget -q --spider --timeout=5 "$uri" && ok=0; fi
    if _have notify-send; then
        if [ $ok -eq 0 ]; then notify-send --urgency=low  "$uri is up"
        else notify-send --urgency=critical "$uri is down"; fi
    else
        [ $ok -eq 0 ] && echo "$uri is up" || echo "$uri is down"
    fi
}

composer-link() {
    composer config minimum-stability dev
    local package=`echo $1 | sed -nr 's/.*\/([^\/]+)$/\1/p'`
    composer config "repositories.$package" '{"type": "path", "url": "'$1'"}'
}

composer-github() {
    composer config minimum-stability dev
    local package=`echo $1 | sed -nr 's/.*\/(.*)\.git/\1/p'`
    composer config "repositories.$package" vcs $1
}




